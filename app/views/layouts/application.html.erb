<!DOCTYPE html>
<html lang="en">
<head>
  <title>Family Heritage Explorer</title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet">
  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  <%= javascript_importmap_tags %>
</head>
<body>
  <header class="site-header">
    <div class="container header-inner">
      <%= link_to root_path, class: "brand" do %>
        <span class="brand-mark">❦</span>
        <span>Family Heritage <em>Explorer</em></span>
      <% end %>
      <nav>
        <%= link_to "Directory", root_path, class: ("active" if current_page?(root_path)) %>
        <%= link_to "Family Tree", tree_path, class: ("active" if current_page?(tree_path)) %>
      </nav>
    </div>
  </header>

  <main class="container"><%= yield %></main>

  <footer class="site-footer">
    <div class="container">Family Heritage Explorer · Built with Ruby on Rails · Copyright MedulaOblongata </div>
  </footer>
</body>
</html>
